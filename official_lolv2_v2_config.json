{
  "version": "v2",
  "training_mode": "epoch",
  "dataset_protocol": "lol-v2-real-official-v1.1",
  "seed": 42,
  "dataset_root": "/path/to/Real_captured",
  "num_epochs": 200,
  "warmup_epochs": 3,
  "warmup_start_lr": 1e-06,
  "peak_lr": 0.0001,
  "min_lr": 1e-06,
  "batch_size": 8,
  "patch_size": 256,
  "num_workers": 2,
  "use_amp": false,
  "vis_every": 10,
  "fixed_vis_count": 5,
  "val_freq_steps": 1000,
  "mixup_beta": 1.2,
  "grad_clip_norm": 0.01,
  "optimizer": {
    "name": "Adam",
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.0
  },
  "loss": "L1",
  "edge_guidance": true,
  "architecture": {
    "in_channels": 3,
    "out_channels": 3,
    "n_feat": 40,
    "stage": 1,
    "num_blocks": [
      1,
      2,
      2
    ]
  },
  "canny": {
    "low_threshold": 50,
    "high_threshold": 100
  },
  "deterministic": true,
  "gated": true
}
